--!nocheck
-- Builds the Command Bar installer and a ready-to-open place file.
-- Run from the repository root:
--   lune run tools/build            writes installer/InstallCutscene.lua and dist/CinematicCutscene.rbxl
--   lune run tools/build --check    fails if the committed installer is out of date

local fs = require("@lune/fs")
local luau = require("@lune/luau")
local process = require("@lune/process")
local roblox = require("@lune/roblox")

local TEMPLATE = "installer/InstallCutscene.template.lua"
local INSTALLER = "installer/InstallCutscene.lua"
local PLACE = "dist/CinematicCutscene.rbxl"
local HEADER = "-- GENERATED by tools/build.luau from installer/InstallCutscene.template.lua.\n"
	.. "-- Paste this whole file into the Roblox Studio Command Bar and press Enter.\n\n"

local function longString(text: string): string
	local level = 0
	while text:find("]" .. string.rep("=", level) .. "]", 1, true) do
		level += 1
	end
	local equals = string.rep("=", level)
	-- Lua drops the newline right after the opening bracket.
	return "[" .. equals .. "[\n" .. text .. "]" .. equals .. "]"
end

local function buildInstaller(): string
	local template = fs.readFile(TEMPLATE)
	-- Read first: file reads yield, which gsub callbacks can't.
	local sources = {}
	for path in template:gmatch('"{{([^}]+)}}"') do
		sources[path] = longString(fs.readFile(path))
	end
	local body = template:gsub('"{{([^}]+)}}"', sources)
	-- Swap the template's own banner (up to the first blank line) for the header.
	local _, bannerEnd = body:find("\n\n", 1, true)
	return HEADER .. body:sub(bannerEnd + 1)
end

-- A baseplate world at dusk with the installer run into it.
local function buildPlace(installer: string): buffer
	local Instance, Vector3, CFrame, Color3, Enum = roblox.Instance, roblox.Vector3, roblox.CFrame, roblox.Color3, roblox.Enum
	local game = Instance.new("DataModel")
	local workspace = game:GetService("Workspace")

	local baseplate = Instance.new("Part")
	baseplate.Name = "Baseplate"
	baseplate.Anchored = true
	baseplate.Locked = true
	baseplate.Size = Vector3.new(2048, 16, 2048)
	baseplate.CFrame = CFrame.new(0, -8, 0)
	baseplate.Color = Color3.fromRGB(70, 72, 80)
	baseplate.Material = Enum.Material.Concrete
	baseplate.TopSurface = Enum.SurfaceType.Smooth
	baseplate.Parent = workspace

	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.CFrame = CFrame.new(0, 0.5, 0)
	spawn.Duration = 0
	spawn.Color = Color3.fromRGB(60, 60, 68)
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = workspace

	local lighting = game:GetService("Lighting")
	lighting.Technology = Enum.Technology.Future
	lighting.ClockTime = 18.2
	lighting.Brightness = 2
	lighting.Ambient = Color3.fromRGB(40, 40, 50)
	lighting.OutdoorAmbient = Color3.fromRGB(90, 90, 110)
	lighting.EnvironmentDiffuseScale = 1
	lighting.EnvironmentSpecularScale = 1
	lighting.GlobalShadows = true
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.35
	atmosphere.Haze = 1.5
	atmosphere.Color = Color3.fromRGB(200, 170, 190)
	atmosphere.Decay = Color3.fromRGB(90, 70, 110)
	atmosphere.Parent = lighting

	local run = luau.load(installer, {
		debugName = "InstallCutscene",
		environment = {
			game = game,
			Instance = Instance,
			Vector3 = Vector3,
			CFrame = CFrame,
			Color3 = Color3,
			Enum = Enum,
			print = function() end,
		},
	})
	run()
	return roblox.serializePlace(game)
end

local installer = buildInstaller()
if table.find(process.args, "--check") then
	local current = if fs.isFile(INSTALLER) then fs.readFile(INSTALLER) else ""
	if current ~= installer then
		print(INSTALLER .. " is out of date; run: lune run tools/build")
		process.exit(1)
	end
	print(INSTALLER .. " is up to date")
	process.exit(0)
end

fs.writeFile(INSTALLER, installer)
print("wrote " .. INSTALLER)
if not fs.isDir("dist") then
	fs.writeDir("dist")
end
fs.writeFile(PLACE, buildPlace(installer))
print("wrote " .. PLACE)
